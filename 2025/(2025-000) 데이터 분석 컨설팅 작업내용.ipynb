import geopandas as gpd
import pandas as pd
import numpy as np

grid50 = gpd.read_file("2025-000_데이터 분석 컨설팅 데이터.gpkg", layer="busan_50m", driver="GPKG")
grid250 = gpd.read_file("2025-000_데이터 분석 컨설팅 데이터.gpkg", layer="ngii_busan_250m", driver="GPKG")

grid50['x'] = grid50.geometry.centroid.x
grid50['y'] = grid50.geometry.centroid.y

result50 = pd.read_csv("집계결과/월별_50m_연령별_생활인구_집계.csv", dtype={'std_ym': str, 'id': str}, encoding="utf-8")
result50_xy = pd.merge(result50, grid50, how="left", on="id")
geom = gpd.points_from_xy(result50_xy['x'], result50_xy['y'], crs="EPSG:5179")
gdf50 = gpd.GeoDataFrame(result50_xy, geometry=geom).drop(columns=['x', 'y'])
gdf250 = gpd.sjoin(grid250, gdf50, how="inner", predicate="intersects")

result250 = gdf250.groupby(['std_ym', 'gid'])[['avg_10', 'avg_20', 'avg_30', 'avg_40', 'avg_50', 'avg_60', 'avg_70']].sum().reset_index().sort_values(by='std_ym')
melted = pd.melt(result250, id_vars=['std_ym', 'gid'], value_vars=['avg_10', 'avg_20', 'avg_30', 'avg_40', 'avg_50', 'avg_60', 'avg_70'], var_name='ages', value_name='pop')
melted['연령대'] = [melted.loc[i, 'ages'].split('_')[1] for i in melted.index]
melted = melted[['std_ym', 'gid', '연령대', 'pop']]
melted.columns = ['기준연월', 'gid', '연령대', '생활인구']
melted.to_csv("집계결과/월별_250m_연령(10세)_생활인구.csv", sep="|", encoding="utf-8", index=False)


melted.to_file




weekday_list = ['월', '화', '수', '목', '금', '토', '일']
df['요일'] = df.apply(lambda x: weekday_list[x['weekday']], axis=1)
df['주별'] = df['weeknum'] + '주'
df['이용금액(만원)'] = round(df['amt'] / 10000, 0)
